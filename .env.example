# 環境變數範本
#
# 本機開發：複製這個檔案為 .env.local 並填入真實金鑰
#     cp .env.example .env.local
#
# 正式環境：在 Vercel Dashboard → Settings → Environment Variables 設定
#
# ⚠️ .env.local 已列入 .gitignore，絕對不要把真實金鑰提交進 repo。
#    本檔案（.env.example）只放佔位字串，可以安全提交。

# ===== Gemini API（分紙照片辨識用）=====
# 申請：https://aistudio.google.com/apikey
# 用途：api/analyze-scoresheet.js
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Google Sheets API（伺服器端讀試算表用）=====
# 申請：https://console.cloud.google.com/apis/credentials → 建立 API 金鑰
#      並在「限制 API」只勾選 Google Sheets API
#
# ⚠️ 這個值只有 api/ 底下的伺服器端函式讀得到，前端頁面讀不到。
#    現在的排名／賽程頁是瀏覽器直接讀試算表，用的是 config/config.js 裡
#    寫死的那把金鑰——前端要用的金鑰一定會公開，放這裡不會生效。
#    要讓金鑰真的保密，讀取必須改由 api/ 的函式代為進行。
#
# ⚠️ API 金鑰只能讀「公開」的試算表，不能寫入。
#    寫入目前走 Google Apps Script，不需要這把金鑰。
GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here

# ===== Shopee Affiliate API（商品輪播用）=====
# 用途：api/shopee-products.js
SHOPEE_APP_ID=your_shopee_app_id_here
SHOPEE_SECRET_KEY=your_shopee_secret_key_here
