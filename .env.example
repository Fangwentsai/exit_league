# 環境變數範本
#
# 本機開發：複製這個檔案為 .env.local 並填入真實金鑰
#     cp .env.example .env.local
#
# 正式環境：在 Vercel Dashboard → Settings → Environment Variables 設定
#
# ⚠️ .env.local 已列入 .gitignore，絕對不要把真實金鑰提交進 repo。
#    本檔案（.env.example）只放佔位字串，可以安全提交。

# ===== Gemini API（分紙照片辨識用）=====
# 申請：https://aistudio.google.com/apikey
# 用途：api/analyze-scoresheet.js
GEMINI_API_KEY=your_gemini_api_key_here

# ===== Google Sheets 存取（伺服器端用）=====
#
# ⚠️ 以下的值只有 api/ 底下的伺服器端函式讀得到，前端頁面讀不到。
#    現在的排名／賽程頁是瀏覽器直接讀試算表，用 config/config.js 裡寫死的
#    那把 API 金鑰——前端要用的金鑰一定會公開，放這裡不會生效。
#
# 三選一，看需求：
#
# (A) API 金鑰 —— 只能讀「公開」試算表，不能寫入。最單純。
# GOOGLE_SHEETS_API_KEY=your_google_sheets_api_key_here
#
# (B) 服務帳號 —— 可讀可寫、不需要任何人按同意、token 不會過期。
#     伺服器端存取自己的試算表建議用這個。
#     設定：Google Cloud Console 建立服務帳號 → 下載 JSON 金鑰 →
#          把試算表「共用」給下面那個 email（要編輯權限才能寫入）
#     私鑰含換行，貼進 .env.local 時整段用雙引號包起來，換行寫成 \n
# GOOGLE_SERVICE_ACCOUNT_EMAIL=xxx@yyy.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# (C) OAuth 2.0「電腦版應用程式」 —— 可讀可寫，但 Vercel 上開不了瀏覽器
#     讓人按同意，必須先在本機跑一次授權流程拿到 refresh token。
#     ⚠️ 同意畫面停在「測試中」的話 refresh token 七天就失效，
#        要在 OAuth 同意畫面把發布狀態改成「已發布」才會長期有效。
# GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your_refresh_token

# ===== Shopee Affiliate API（商品輪播用）=====
# 用途：api/shopee-products.js
SHOPEE_APP_ID=your_shopee_app_id_here
SHOPEE_SECRET_KEY=your_shopee_secret_key_here
